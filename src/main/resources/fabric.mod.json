{
  "schemaVersion": 1,
  "id": "$id",
  "version": "$version",
  "name": "$libname",
  "description": "$description",
  "authors": $authors_list,
  "contributors": $contributors_list,
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/$slug",
    "sources": "https://github.com/$github",
    "issues": "https://github.com/$github/issues",
    "email": "SrRapero720@hotmail.com"
  },

  "license": "$license",
  "icon": "pack.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "org.watermedia.binaries.bootstrap.FabricBootstrap"
    ]
  },
  "depends": {
    "watermedia": $watermediafabric,
    "minecraft": $minecraftfabric,
    "fabricloader": "$fabricrange",
    "java": "$javarange"
  }
}
