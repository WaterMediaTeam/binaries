+static int http_same_origin(const char *origin, const char *target)
+{
+    URLComponents urls[2];
+    int ports[2];
+
+    if (!origin || !target || ff_url_decompose(&urls[0], origin, NULL) < 0 ||
+        ff_url_decompose(&urls[1], target, NULL) < 0)
+        return 0;
+
+    for (int i = 0; i < 2; i++) {
+        URLComponents *url = &urls[i];
+        size_t scheme_len = url->authority - url->scheme;
+
+        if (!URL_COMPONENT_HAVE(*url, authority) || !URL_COMPONENT_HAVE(*url, host))
+            return 0;
+        if (scheme_len == 5 && !av_strncasecmp(url->scheme, "http:", 5))
+            ports[i] = 80;
+        else if (scheme_len == 6 && !av_strncasecmp(url->scheme, "https:", 6))
+            ports[i] = 443;
+        else
+            return 0;
+
+        if (URL_COMPONENT_HAVE(*url, port)) {
+            const char *p = url->port + 1;
+            if (p == url->path)
+                return 0;
+            ports[i] = 0;
+            for (; p < url->path; p++) {
+                if (*p < '0' || *p > '9' || ports[i] > (65535 - (*p - '0')) / 10)
+                    return 0;
+                ports[i] = ports[i] * 10 + *p - '0';
+            }
+        }
+    }
+
+    return ports[0] == ports[1] &&
+           urls[0].authority - urls[0].scheme == urls[1].authority - urls[1].scheme &&
+           !av_strncasecmp(urls[0].scheme, urls[1].scheme, urls[0].authority - urls[0].scheme) &&
+           urls[0].port - urls[0].host == urls[1].port - urls[1].host &&
+           !av_strncasecmp(urls[0].host, urls[1].host, urls[0].port - urls[0].host);
+}
